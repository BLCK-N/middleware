    {
      "name": "10 - (reference) Apply code at individual signup",
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Doe\",\n  \"emailAddress\": \"jane.doe@example.com\",\n  \"phoneNumber\": \"+2348012345678\",\n  \"password\": \"Password123\",\n  \"bvn\": \"12345678901\",\n  \"address\": \"12 Marina Road, Lagos\",\n  \"gender\": \"female\",\n  \"isPep\": false,\n  \"nextOfKins\": [],\n  \"inviteCode\": \"{{inviteCode}}\",\n  \"otpReference\": \"<otp-reference>\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/create-account",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "create-account"]
        },
        "description": "Reference only (lives in the Auth API). The optional `inviteCode` field links the new user to an agent. Unknown/blank codes are ignored and signup still succeeds."
      },
      "response": []
    }
